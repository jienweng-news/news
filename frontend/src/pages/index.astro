---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryList from '../components/StoryList.astro';
import { createContentRepository } from '../lib/content/repository';
import { composeNewsroom } from '../lib/content/newsroom';
import { runtimeConfig } from '../lib/runtime';
import type { ArticleCard } from '../lib/content/types';
const config = runtimeConfig(); let articles: ArticleCard[] = []; let unavailable = false;
try { articles = await createContentRepository(config).listPublished(); } catch { unavailable = true; Astro.response.status = 503; }
Astro.response.headers.set('Cache-Control', 'no-store');
const { lead, latest, sections, analysis } = composeNewsroom(articles);
---
<BaseLayout title="The latest" noindex={unavailable}>
  <div class="edition-heading"><h1>The latest</h1><p>Understand what’s next.</p></div>
  {unavailable ? <section class="empty-state"><h2>Stories are temporarily unavailable.</h2><p>Please try again shortly.</p></section> : lead ? <div class="front-grid">
    <article class="lead-story">
      <a class="lead-link" href={`/articles/${lead.slug}/`}>
        {lead.media ? <img class="lead-image" src={lead.media.url} alt={lead.media.alt} width="1200" height="675" fetchpriority="high" /> : <div class="lead-graphic" aria-hidden="true"><span>TOKEN</span><span>ON AIR<span class="graphic-period">.</span></span><i></i></div>}
        <h2>{lead.title}</h2>
      </a>
      <p class="deck">{lead.summary}</p>
      <div class="story-footer"><span>{lead.section === 'ai' ? 'AI' : 'Crypto'} / {lead.format}</span><span>Edited by jienweng</span><a href={`/articles/${lead.slug}/`}>Read story <span aria-hidden="true">→</span></a></div>
    </article>
    <aside class="latest-column" aria-label="Latest headlines"><h2>Latest headlines</h2>
      {latest.length ? <StoryList articles={latest} compact /> : <p>More stories will appear here as they are published.</p>}
      <div class="desk-note"><h3>Technology moves.<br />Keep your perspective.</h3><p>AI, crypto and the ideas shaping what comes next.</p></div>
    </aside>
  </div> : <section class="empty-state"><h2>The first edition is taking shape.</h2><p>Stories will appear here when published.</p></section>}
  {!unavailable && <>
    <div class="section-grid">{(['ai','crypto'] as const).map(section => <section class="section-front" id={section}>
      <div class="section-heading"><h2><a href={`/${section}/`}>{section === 'ai' ? 'Artificial intelligence' : 'Crypto'}</a></h2><a href={`/${section}/`} aria-label={`All ${section === 'ai' ? 'AI' : 'crypto'} stories`}>View all <span aria-hidden="true">→</span></a></div>
      {sections[section].length ? <StoryList articles={sections[section].slice(0, 3)} /> : <p class="section-empty">Coverage will appear here when published.</p>}
    </section>)}</div>
    {analysis.length > 0 && <section class="analysis-front"><div class="section-heading"><h2>In perspective</h2><span>Analysis</span></div><StoryList articles={analysis} /></section>}
  </>}
</BaseLayout>
