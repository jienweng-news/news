---
import HomePage from '../../components/HomePage.astro';
import {createContentRepository} from '../../lib/content/repository';
import {runtimeConfig} from '../../lib/runtime';
import {resolveListingPage} from '../../lib/content/listing';
import {isLocale} from '../../lib/i18n';
const locale=Astro.params.locale;if(!isLocale(locale))return new Response('Not found',{status:404});
const config=runtimeConfig();
const result=await resolveListingPage(()=>createContentRepository(config).listPublished(locale),config.contentMode!=='fixture');
Astro.response.status=result.status;
Astro.response.headers.set('Cache-Control',result.cacheControl);
---
<HomePage locale={locale} articles={result.articles} unavailable={result.unavailable}/>
