---
import {authorImage} from '../lib/news-images';
import {t,localePath,languageTag,type Locale} from '../lib/i18n';
import type { Article } from '../lib/content/types';
interface Props { article: Article;locale?:Locale }
const { article,locale='en' } = Astro.props;
const date = (v: string) => new Intl.DateTimeFormat(languageTag[locale], { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(v));
---
<div class="article-meta"><span class="byline">{t(locale,'by')} <a href={localePath(locale,`authors/${article.author.slug}`)}><img src={authorImage(article.author).url} alt="" width="32" height="32"/>{article.author.name}</a></span><span data-article-author>{t(locale,'editor')} <strong>jienweng</strong></span><span>{t(locale,'published')} <time datetime={article.publishedAt}>{date(article.publishedAt)}</time></span>{article.updatedAt !== article.publishedAt && <span>{t(locale,'updated')} <time datetime={article.updatedAt}>{date(article.updatedAt)}</time></span>}</div>
