---
import {t,type Locale} from '../lib/i18n';
interface Props { visible: boolean;locale?:Locale }
const { visible,locale='en' } = Astro.props;
---
{visible && <aside class="fixture-banner" aria-label="Development content"><span class="status-dot"></span><strong>{t(locale,'fixture')}</strong><span>{t(locale,'fixtureNote')}</span></aside>}
