---
import BaseLayout from '../layouts/BaseLayout.astro';
import {t,type Locale} from '../lib/i18n';
interface Props{locale:Locale;page:'about'|'policy'|'privacy'|'contact'|'advertise'}
const {locale,page}=Astro.props;
const en={about:['Token on Air covers artificial intelligence, crypto and related technology for builders, technology users and market followers.','Editor: jienweng. We bring a global perspective with attention to Taiwan and Asia.'],policy:['We distinguish news, analysis, guides, reviews and announcements. Stories should link to retrievable sources and separate evidence from claims.','Sponsored coverage, affiliate links and founder-project coverage carry visible labels. A commercial relationship does not establish independent verification.','Material corrections carry dated notes. Publication dates are preserved when stories are updated. Contact the editor to raise an accuracy concern.'],privacy:['Reading does not require an account. Your selected edition is saved in a language preference cookie when you use the language switcher.','If enabled, Google Analytics loads only after you allow it. You can reopen privacy choices to withdraw analytics permission. We send page paths without search queries or email addresses; GA4 may use cookies and collect device/network information.','Newsletter signup is handled by beehiiv. We send your email address and selected language to that service, request confirmation, and preserve unsubscribe status. Each future issue must provide unsubscribe controls. Digest delivery has not started.','Enabled signup forms use Cloudflare Turnstile to prevent automated abuse. Hosting, CMS, newsletter and anti-abuse providers may process request information to operate their services. Public contact details and retention arrangements must be verified before launch.'],contact:['For corrections, source concerns and publication enquiries, contact the editor using the verified address below.'],advertise:['Advertising and sponsorship opportunities will be considered as the publication develops. No active partnership or audience size is implied.','Paid placements and founder-project coverage must be labelled. Editorial evidence and correction standards apply independently of commercial arrangements.']};
const trad={about:['Token on Air 關注人工智慧、加密貨幣與相關科技，服務開發者、科技使用者與市場讀者。','編輯：jienweng。我們以全球視角關注台灣與亞洲。'],policy:['我們區分新聞、分析、指南、評測與公告。報導應連結可查證來源，並區分證據與主張。','贊助內容、聯盟連結與創辦人專案須清楚標示。商業關係並不代表獨立驗證。','重要更正會附註日期，更新時保留首次發布日期。如有準確性疑慮，請聯絡編輯。'],privacy:['閱讀無須註冊。使用語言切換功能後，我們會以偏好 Cookie 儲存您選擇的版本。','如啟用 Google Analytics，僅在您同意後載入。您可透過隱私選項撤回同意。傳送的頁面路徑不含搜尋內容或電子郵件；GA4 可能使用 Cookie 並收集裝置與網路資訊。','電子報訂閱由 beehiiv 處理。我們將電子郵件與語言偏好傳送給該服務，要求確認並保留取消訂閱狀態。未來各期須提供退訂方式。目前尚未開始寄送。','如啟用訂閱表單，將使用 Cloudflare Turnstile 防止自動濫用。託管、CMS、電子報與防濫用服務可能處理運作所需的請求資訊。正式上線前仍須確認公開聯絡方式與資料保留安排。'],contact:['更正、來源疑慮與出版詢問，請透過下方已驗證的地址聯絡編輯。'],advertise:['我們將隨出版業務發展評估廣告與贊助合作；此頁不代表已有合作夥伴或特定讀者規模。','付費版位與創辦人專案須明確標示，證據與更正標準不受商業安排影響。']};
const simp={about:['Token on Air 关注人工智能、加密货币与相关科技，服务开发者、科技用户与市场读者。','编辑：jienweng。我们以全球视角关注台湾与亚洲。'],policy:['我们区分新闻、分析、指南、评测与公告。报道应链接可查证来源，并区分证据与主张。','赞助内容、推广链接与创办人项目须清楚标示。商业关系并不代表独立验证。','重要更正会附注日期，更新时保留首次发布日期。如有准确性疑虑，请联系编辑。'],privacy:['阅读无须注册。使用语言切换功能后，我们会以偏好 Cookie 保存您选择的版本。','如启用 Google Analytics，仅在您同意后加载。您可通过隐私选项撤回同意。发送的页面路径不含搜索内容或电子邮箱；GA4 可能使用 Cookie 并收集设备与网络信息。','电子报订阅由 beehiiv 处理。我们将电子邮箱与语言偏好发送给该服务，要求确认并保留退订状态。未来各期须提供退订方式。目前尚未开始发送。','如启用订阅表单，将使用 Cloudflare Turnstile 防止自动滥用。托管、CMS、电子报与防滥用服务可能处理运行所需的请求信息。正式上线前仍须确认公开联系方式与数据保留安排。'],contact:['更正、来源疑虑与出版咨询，请通过下方已验证的地址联系编辑。'],advertise:['我们将随出版业务发展评估广告与赞助合作；此页不代表已有合作伙伴或特定读者规模。','付费版位与创办人项目须明确标示，证据与更正标准不受商业安排影响。']};
const paragraphs=({en,zh:trad,'zh-cn':simp})[locale][page];
const email=process.env.MAIL_VERIFIED==='1'&&/^[^\s@<>]+@tokenonair\.com$/.test(process.env.PUBLIC_CONTACT_EMAIL||'')?process.env.PUBLIC_CONTACT_EMAIL:undefined;
---
<BaseLayout locale={locale} title={t(locale,page)}><article class="article-page"><header class="article-header"><h1>{t(locale,page)}</h1></header><div class="prose">{paragraphs.map(p=><p>{p}</p>)}{page==='contact'&&(email?<p><a href={`mailto:${email}`}>{email}</a></p>:<p>{locale==='en'?'Verified contact details will appear before launch.':locale==='zh'?'已驗證的聯絡方式將於上線前公布。':'已验证的联系方式将在上线前公布。'}</p>)}</div></article></BaseLayout>
