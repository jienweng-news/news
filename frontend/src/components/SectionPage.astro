---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryList from './StoryList.astro';
import { createContentRepository } from '../lib/content/repository';
import { selectSection } from '../lib/content/newsroom';
import { runtimeConfig } from '../lib/runtime';
import type { Section, ArticleCard } from '../lib/content/types';
interface Props { section: Section }
const { section } = Astro.props;
const title = section === 'ai' ? 'Artificial intelligence' : 'Crypto';
let articles: ArticleCard[] = []; let unavailable = false;
try { articles = selectSection(await createContentRepository(runtimeConfig()).listPublished(), section); }
catch { unavailable = true; Astro.response.status = 503; }
Astro.response.headers.set('Cache-Control', 'no-store');
---
<BaseLayout title={title} noindex={unavailable} description={section === 'ai' ? 'AI news, practical guides and analysis from Token on Air.' : 'Crypto news, practical guides and analysis from Token on Air.'}>
  <div class="section-page-heading"><a class="back-link" href="/">Back to the latest</a><h1>{title}</h1><p>{section === 'ai' ? 'Models, tools and the businesses shaping intelligence.' : 'Networks, markets and the changing ownership of technology.'}</p></div>
  {unavailable ? <section class="empty-state"><h2>Stories are temporarily unavailable.</h2><p>Please try again shortly.</p></section> : articles.length ? <div class="section-stories"><StoryList articles={articles} /></div> : <section class="empty-state"><h2>Coverage is on the way.</h2><p>Stories will appear here when published.</p></section>}
</BaseLayout>
