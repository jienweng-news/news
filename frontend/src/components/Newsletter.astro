---
import SelectField from './SelectField.astro';
import {localeLabel,locales,languageTag,t,type Locale} from '../lib/i18n';
import {newsletterReady} from '../lib/newsletter';
interface Props {locale:Locale}
const {locale}=Astro.props;const enabled=newsletterReady(process.env);
---
<section class="newsletter" aria-labelledby="newsletter-heading">
 <div class="newsletter-intro">
  <svg class="newsletter-icon" viewBox="0 0 48 36" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="44" height="32"/><path d="m2 3 22 17L46 3"/></svg>
  <h2 id="newsletter-heading">{t(locale,'subscribe')}</h2>
  <p>{t(locale,'signupNote')}</p>
 </div>
 <form method="POST" action="/api/subscribe" data-newsletter-form data-success={t(locale,'signupAccepted')} data-error={t(locale,'signupError')}><input type="hidden" name="locale" value={locale}/><div class="newsletter-fields"><label>{t(locale,'email')}<input name="email" type="email" autocomplete="email" maxlength="254" required disabled={!enabled} placeholder="you@example.com"/></label><SelectField name="language" label={t(locale,'language')} value={locale} disabled={!enabled} options={[...locales.map(l=>({value:l,label:localeLabel[l],lang:languageTag[l]})),{value:'all',label:t(locale,'allLanguages')}]} /></div>
 <label class="signup-consent"><input type="checkbox" name="consent" value="yes" required disabled={!enabled}/><span>{t(locale,'subscribeConsent')} <a href={`/${locale}/privacy/`}>{t(locale,'privacy')}</a></span></label><div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"/></label></div>
 {enabled&&<div class="cf-turnstile" data-sitekey={process.env.PUBLIC_TURNSTILE_SITE_KEY}></div>}
 <p role="status" data-signup-status></p><button type="submit" disabled={!enabled}><span>{t(locale,'submit')}</span><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></button>{!enabled&&<p class="signup-unavailable">{t(locale,'signupError')}</p>}</form>
 {enabled&&<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
{enabled&&<script is:inline type="module" src="/scripts/newsletter.js"></script>}
</section>
