---
import RelationshipLabel from './RelationshipLabel.astro';
import {t,localePath,languageTag,type Locale} from '../lib/i18n';
import type { ArticleCard } from '../lib/content/types';
interface Props { articles: ArticleCard[]; compact?: boolean; locale?:Locale; headingLevel?:'h2'|'h3' }
const { articles, compact = false, locale='en', headingLevel='h3' } = Astro.props;
const Heading=headingLevel;
const date = (value: string) => new Intl.DateTimeFormat(languageTag[locale], { month: 'short', day: 'numeric', timeZone: 'UTC' }).format(new Date(value));
---
<div class:list={['story-list', { compact }]}>
  {articles.map(article => <article class="story-item">
    <Heading><a href={localePath(locale,`articles/${article.slug}`)}>{article.title}</a></Heading>
    {!compact && <p>{article.summary}</p>}
    <div class="story-details"><RelationshipLabel locale={locale} relationship={article.relationship} /><span>{t(locale,article.section)}</span><span>{t(locale,article.format)}</span><time datetime={article.publishedAt}>{date(article.publishedAt)}</time></div>
  </article>)}
</div>
