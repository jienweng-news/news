---
import ImageCredit from './ImageCredit.astro';
import {storyImage,imageCaption} from '../lib/news-images';
import RelationshipLabel from './RelationshipLabel.astro';
import {publicationTime} from '../lib/news-date';
import {t,localePath,type Locale} from '../lib/i18n';
import type { ArticleCard } from '../lib/content/types';
interface Props { articles: ArticleCard[]; compact?: boolean; locale?:Locale; headingLevel?:'h2'|'h3';layout?:'standard'|'rows' }
const { articles, compact = false, locale='en', headingLevel='h3',layout='standard' } = Astro.props;
const Heading=headingLevel;

---
<div class:list={['story-list', { compact, 'news-rows':layout==='rows' }]}>
  {articles.map(article => <article class="story-item">
    {!compact&&<figure class="story-thumbnail"><a href={localePath(locale,`articles/${article.slug}`)} tabindex="-1" aria-hidden="true"><img class:list={{'source-chart':storyImage(article,locale).credit==='PANews'}} src={storyImage(article,locale).url} alt="" width="1200" height="630" loading="lazy" decoding="async"/></a>{imageCaption(article)&&<ImageCredit image={storyImage(article,locale)}/>}</figure>}
    <Heading><a href={localePath(locale,`articles/${article.slug}`)}>{article.title}</a></Heading>
    {!compact && <p>{article.summary}</p>}
    <div class="story-details"><RelationshipLabel locale={locale} relationship={article.relationship} /><span>{t(locale,article.section)}</span><span>{t(locale,article.format)}</span><time datetime={article.publishedAt}>{publicationTime(article.publishedAt,locale)}</time></div>
  </article>)}
</div>
