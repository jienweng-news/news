# Copy to .env in the repository root. Never commit actual credentials.
APP_ENV=local
CONTENT_MODE=fixture
SITE_URL=http://localhost:4321
PUBLIC_SITE_NAME=Token on Air
SANITY_PROJECT_ID=4k0o7q9m
SANITY_DATASET=production
SANITY_READ_TOKEN=
# Local preview only; generate independent random values of at least 32 characters.
PREVIEW_ACCESS_KEY=
PREVIEW_SIGNING_SECRET=

# Optional production audience analytics; consent required before any Google request.
GA4_MEASUREMENT_ID=G-WQMMLS9H2X
# Enable only after beehiiv language field, double-opt-in and suppression tests.
NEWSLETTER_ENABLED=0
BEEHIIV_SETUP_VERIFIED=0
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_LANGUAGE_FIELD=Language
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Separate private worker only; never install write/validation credentials on public frontend.
AUTOMATION_ENABLED=0
AUTOMATION_KILL_SWITCH=1
AUTOMATION_DB=.private/jobs.sqlite
AUTOMATION_SOURCES=docs/research/source-checks/2026-10-22-fixed-sources.json
SANITY_WRITE_TOKEN=
SANITY_EDITOR_ID=
VALIDATION_SECRET=

# Set only after mailbox delivery and acceptance evidence is recorded.
PUBLIC_CONTACT_EMAIL=
MAIL_VERIFIED=0
LAUNCH_ACCEPTANCE_VERIFIED=0
AUTOMATION_ACCEPTANCE_VERIFIED=0
DEPENDENCY_REVIEW_VERIFIED=0
