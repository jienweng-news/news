{
  "name": "news-publication",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "studio"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "npm run dev --workspace frontend --",
    "dev:studio": "npm run dev --workspace studio",
    "check": "npm run check --workspace frontend",
    "test": "vitest run",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend --",
    "verify:foundation": "node scripts/check-foundation.mjs",
    "automation": "tsx automation/cli.ts",
    "verify:launch": "node scripts/check-launch.mjs",
    "check:automation": "tsc -p tsconfig.automation.json",
    "preflight": "tsx scripts/preflight.ts",
    "verify:local": "node scripts/verify-local.mjs",
    "check:client": "node --check frontend/public/scripts/analytics.js && node --check frontend/public/scripts/newsletter.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "22.20.5",
    "miniflare": "5.20261019.2-beta",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "@vercel/frameworks": {
      "js-yaml": "3.15.2"
    },
    "smol-toml": "1.9.1",
    "typeid-js": {
      "uuid": "11.1.1"
    }
  }
}
