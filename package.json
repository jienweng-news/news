{
  "name": "news-publication",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "studio"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "npm run dev --workspace frontend --",
    "dev:studio": "npm run dev --workspace studio",
    "check": "npm run check --workspace frontend",
    "test": "vitest run",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend --",
    "verify:foundation": "node scripts/check-foundation.mjs"
  },
  "devDependencies": {
    "vitest": "4.1.12",
    "typescript": "5.9.3",
    "@types/node": "22.20.5"
  }
}
